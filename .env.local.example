# URL of buildcore-api — see ../buildcore-api
NEXT_PUBLIC_API_URL=http://localhost:3000

# Maximum GPS uncertainty (metres) the punch screen will accept before asking for a
# better fix. Defaults to 100, which suits a phone on site but is often
# unachievable on a laptop positioning from Wi-Fi — raise it for local testing,
# e.g. NEXT_PUBLIC_MAX_GPS_ACCURACY_METERS=5000
# NEXT_PUBLIC_MAX_GPS_ACCURACY_METERS=100

# Stand-in coordinates used ONLY in development, and only when the browser cannot
# locate the device (common on a laptop, which has no GPS, or when the OS has
# location switched off for the browser). Never used in a production build, and the
# UI says plainly when a punch used them.
#
# These default to the demo site seeded by the API's `npm run seed`, so a fallback
# punch lands inside the geofence. To test somewhere real, set these to your own
# coordinates AND seed the site to match:
#   SEED_SITE_LATITUDE=<lat> SEED_SITE_LONGITUDE=<lng> npm run seed   # in buildcore-api
# NEXT_PUBLIC_DEV_FALLBACK_LATITUDE=19.076
# NEXT_PUBLIC_DEV_FALLBACK_LONGITUDE=72.8777
